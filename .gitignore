momo-installer/stage/
momo-installer/*.wixobj
momo-installer/*.wixpdb
*.csproj.user
bin/
obj/

# 上の bin/ は .NET のビルド出力用だが、Cargo の追加バイナリ規約である
# src/bin/ とパス名が衝突するため、momors-cli の src/bin/ だけ除外を解除する。
!momors/crates/momors-cli/src/bin/
!momors/crates/momors-cli/src/bin/**


# momors-esp32 (ESP-IDF ビルド生成物)
momors/crates/momors-esp32/target/
momors/crates/momors-esp32/.embuild/
momors/crates/momors-esp32/sdkconfig
momors/crates/momors-esp32/sdkconfig.old
