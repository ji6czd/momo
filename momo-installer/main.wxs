<?xml version='1.0' encoding='UTF-8'?>
<!--
  $(var.Version)   - バージョン番号 (例: 0.1.0)。candle に -dVersion=x.y.z で渡す。
  $(var.StageDir)  - ステージングディレクトリ (stage/)。candle に -dStageDir=<path> で渡す。
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='Momo'
        UpgradeCode='B4C7E921-3F5A-4D8B-9E1C-6A2D8F0B4E73'
        Manufacturer='KIRIAKE Masanori'
        Language='1041'
        Codepage='932'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Manufacturer='KIRIAKE Masanori'
            InstallerVersion='450'
            Languages='1041'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='932'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='新しいバージョンの [ProductName] がすでにインストールされています。'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>

            <!-- スタートメニュー -->
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='Momo'>
                    <Component Id='ApplicationShortcut' Guid='*'>
                        <Shortcut Id='StartMenuShortcut'
                                  Name='Momo 点字変換'
                                  Description='日本語テキストを点字に変換します'
                                  Target='[Bin]momo-gui.exe'
                                  WorkingDirectory='Bin'/>
                        <Shortcut Id='MomoEditorStartMenuShortcut'
                                  Name='Momo エディタ'
                                  Description='点字エディタ'
                                  Target='[Bin]MomoEditor.exe'
                                  WorkingDirectory='Bin'/>
                        <RemoveFolder Id='CleanUpShortCut'
                                      Directory='ApplicationProgramsFolder'
                                      On='uninstall'/>
                        <RegistryValue
                            Root='HKCU'
                            Key='Software\Momo'
                            Name='installed'
                            Type='integer'
                            Value='1'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>

            <!-- Windows Fonts フォルダ。点字セル(U+2800-28FF)をエディタで表示するための
                 SixBraille（横線・枠あり = HLF face を含む12書体入りの .ttc）を同梱・
                 システムインストールする。ライセンス文言は licenses\SixBraille-LICENSE.txt
                 として APPLICATIONFOLDER に同梱。 -->
            <Directory Id='FontsFolder'>
                <Component Id='SixBrailleFont' Guid='D3E4F5A6-1B2C-4D8E-9F0A-3C5E7B9D1F24'>
                    <File Id='SixBrailleTtc'
                          Name='sixbraille.ttc'
                          DiskId='1'
                          Source='$(var.StageDir)\fonts\sixbraille.ttc'
                          KeyPath='yes'
                          TrueType='yes'/>
                </Component>
            </Directory>

            <!-- Program Files\Momo\ -->
            <Directory Id='$(var.PlatformProgramFilesFolder)'>
                <Directory Id='APPLICATIONFOLDER' Name='Momo'>

                    <Directory Id='Bin' Name='bin'>
                        <!-- PATH に bin\ を追加 -->
                        <Component Id='Path'
                                   Guid='E5F6A7B8-C9D0-1E2F-3A4B-5C6D7E8F9012'
                                   KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <!-- momo.exe (Rust CLI) + momors_ffi.dll (FFI ライブラリ) -->
                        <Component Id='MomoCli' Guid='69B9CCC3-B027-43B6-BBD1-EBBC64CAE445'>
                            <File Id='MomoCliExe'
                                  Name='momo.exe'
                                  DiskId='1'
                                  Source='$(var.StageDir)\bin\momo.exe'
                                  KeyPath='yes'/>
                            <File Id='MomorsFfiDll'
                                  Name='momors_ffi.dll'
                                  DiskId='1'
                                  Source='$(var.StageDir)\bin\momors_ffi.dll'/>
                        </Component>
                        <!-- MomoEditor.exe (.NET 点字エディタ) -->
                        <Component Id='MomoEditor' Guid='68C5A748-909B-4DC6-8AE1-A7800CC0808A'>
                            <File Id='MomoEditorExe'
                                  Name='MomoEditor.exe'
                                  DiskId='1'
                                  Source='$(var.StageDir)\bin\MomoEditor.exe'
                                  KeyPath='yes'/>
                            <File Id='MomoEditorDll'
                                  Name='MomoEditor.dll'
                                  DiskId='1'
                                  Source='$(var.StageDir)\bin\MomoEditor.dll'/>
                            <File Id='MomoEditorDepsJson'
                                  Name='MomoEditor.deps.json'
                                  DiskId='1'
                                  Source='$(var.StageDir)\bin\MomoEditor.deps.json'/>
                            <File Id='MomoEditorRuntimeConfig'
                                  Name='MomoEditor.runtimeconfig.json'
                                  DiskId='1'
                                  Source='$(var.StageDir)\bin\MomoEditor.runtimeconfig.json'/>
                            <!-- 点字ドキュメントのモデルと momors_ffi.dll への P/Invoke ラッパ。
                                 MomoEditor.exe はこのアセンブリが無いと起動できない。 -->
                            <File Id='MomoFfiDll'
                                  Name='Momo.Ffi.dll'
                                  DiskId='1'
                                  Source='$(var.StageDir)\bin\Momo.Ffi.dll'/>
                        </Component>
                        <!-- momo-gui.exe (.NET GUI) -->
                        <Component Id='MomoGui' Guid='97EA0808-62CA-4FF3-8C59-31CDC0D16CD8'>
                            <File Id='MomoGuiExe'
                                  Name='momo-gui.exe'
                                  DiskId='1'
                                  Source='$(var.StageDir)\bin\momo-gui.exe'
                                  KeyPath='yes'/>
                            <File Id='MomoGuiDll'
                                  Name='momo-gui.dll'
                                  DiskId='1'
                                  Source='$(var.StageDir)\bin\momo-gui.dll'/>
                            <File Id='MomoGuiDepsJson'
                                  Name='momo-gui.deps.json'
                                  DiskId='1'
                                  Source='$(var.StageDir)\bin\momo-gui.deps.json'/>
                            <File Id='MomoGuiRuntimeConfig'
                                  Name='momo-gui.runtimeconfig.json'
                                  DiskId='1'
                                  Source='$(var.StageDir)\bin\momo-gui.runtimeconfig.json'/>
                        </Component>
                        <!-- .mbr ファイルの関連付け（任意機能）。
                             ダブルクリックや「プログラムから開く」で MomoEditor.exe が
                             起動するようにする。レジストリのみの独立コンポーネントなので、
                             Feature 単位でインストール可否を選べる。アンインストール時は
                             登録も一緒に削除される。[#MomoEditorExe] は同梱される
                             MomoEditor.exe のフルパスに解決される。 -->
                        <Component Id='FileAssociationMbr'
                                   Guid='7C4E1A93-2B6D-4F80-9E3A-15C8D0B2A6F4'>
                            <!-- 拡張子 .mbr → ProgId（既定で開くアプリ） -->
                            <RegistryValue Root='HKLM' Key='Software\Classes\.mbr'
                                           Value='Momo.BrailleDocument' Type='string' KeyPath='yes'/>
                            <RegistryValue Root='HKLM' Key='Software\Classes\.mbr\OpenWithProgids'
                                           Name='Momo.BrailleDocument' Value='' Type='string'/>
                            <!-- ProgId 本体（表示名・アイコン・開くコマンド） -->
                            <RegistryValue Root='HKLM' Key='Software\Classes\Momo.BrailleDocument'
                                           Value='Momo 点字ドキュメント' Type='string'/>
                            <RegistryValue Root='HKLM' Key='Software\Classes\Momo.BrailleDocument\DefaultIcon'
                                           Value='[#MomoEditorExe],0' Type='string'/>
                            <RegistryValue Root='HKLM' Key='Software\Classes\Momo.BrailleDocument\shell\open\command'
                                           Value='"[#MomoEditorExe]" "%1"' Type='string'/>
                            <!-- 「プログラムから開く」の一覧へ常に MomoEditor を出すための登録 -->
                            <RegistryValue Root='HKLM' Key='Software\Classes\Applications\MomoEditor.exe\shell\open\command'
                                           Value='"[#MomoEditorExe]" "%1"' Type='string'/>
                            <RegistryValue Root='HKLM' Key='Software\Classes\Applications\MomoEditor.exe\SupportedTypes'
                                           Name='.mbr' Value='' Type='string'/>
                        </Component>
                    </Directory>

                    <Directory Id='Licenses' Name='licenses'>
                        <!-- SixBraille のライセンス文言（フォント本体は FontsFolder に別途配置） -->
                        <Component Id='SixBrailleLicense' Guid='6A8C2E4F-0D1B-4A3C-8E5F-2B4D6C8A0E31'>
                            <File Id='SixBrailleLicenseTxt'
                                  Name='SixBraille-LICENSE.txt'
                                  DiskId='1'
                                  Source='$(var.StageDir)\licenses\SixBraille-LICENSE.txt'
                                  KeyPath='yes'/>
                        </Component>
                    </Directory>

                    <Directory Id='Data' Name='data'>
                        <!-- 学習済みモデルと変換テーブル -->
                        <Component Id='DataFiles' Guid='F6FAD1D0-6CFD-49B9-AAFE-84705CF0BFC4'>
                            <File Id='model4' Name='basic_data_4.mbm' DiskId='1'
                                  Source='$(var.StageDir)\data\basic_data_4.mbm' KeyPath='yes'/>
                            <File Id='model5' Name='basic_data_5.mbm' DiskId='1'
                                  Source='$(var.StageDir)\data\basic_data_5.mbm'/>
                            <File Id='model7' Name='basic_data_7.mbm' DiskId='1'
                                  Source='$(var.StageDir)\data\basic_data_7.mbm'/>
                            <!-- 単一漢字辞書は .mbm に同梱されるため配布しない
                                 （single-dict オプションの明示指定で上書きは可能）。 -->
                            <!-- 人名辞書。読み・フラグは .mbm に同梱済みのため配布しない。 -->
                        </Component>
                        <!-- MOMO_DATASET_DIR 環境変数 -->
                        <Component Id='DatasetEnv'
                                   Guid='F6A7B8C9-D0E1-2F3A-4B5C-6D7E8F901234'
                                   KeyPath='yes'>
                            <Environment
                                Id='MOMO_DATASET_DIR'
                                Name='MOMO_DATASET_DIR'
                                Value='[Data]'
                                Permanent='no'
                                Action='set'
                                System='yes'/>
                        </Component>
                    </Directory>

                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Application'
            Title='Momo 点字変換'
            Description='点字変換エンジン (CLI + GUI) とモデルデータをインストールします。'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='MomoCli'/>
            <ComponentRef Id='MomoGui'/>
            <ComponentRef Id='MomoEditor'/>
            <ComponentRef Id='DataFiles'/>
            <ComponentRef Id='DatasetEnv'/>
            <ComponentRef Id='ApplicationShortcut'/>
            <ComponentRef Id='SixBrailleFont'/>
            <ComponentRef Id='SixBrailleLicense'/>

            <Feature
                Id='EnvironmentPath'
                Title='PATH 環境変数'
                Description='momo コマンドをどこからでも呼び出せるように PATH に追加します。'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>

            <Feature
                Id='FileAssociation'
                Title='.mbr ファイルの関連付け'
                Description='.mbr（Momo 点字ドキュメント）をダブルクリックや「プログラムから開く」で Momo エディタで開けるようにします。'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='FileAssociationMbr'/>
            </Feature>

        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <!-- .NET Windows Desktop Runtime (x64) の検出 -->
        <!-- Depth='0' で Microsoft.WindowsDesktop.App ディレクトリの存在を確認。 -->
        <!-- バージョン不一致は .NET ランタイム自身が適切なエラーを表示するため、ここでは未インストールのみを弾く。 -->
        <Property Id='DOTNET_DESKTOP_INSTALLED'>
            <DirectorySearch Id='DotNetDesktopSearch'
                             Path='[ProgramFiles64Folder]dotnet\shared\Microsoft.WindowsDesktop.App'
                             Depth='0'/>
        </Property>
        <Condition Message='.NET 10 Windows Desktop Runtime (x64) がインストールされていません。&#xA;https://dotnet.microsoft.com/ja-jp/download/dotnet/10.0 からダウンロードしてインストールしてください。'>
            <![CDATA[Installed OR DOTNET_DESKTOP_INSTALLED]]>
        </Condition>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>

    </Product>

</Wix>
