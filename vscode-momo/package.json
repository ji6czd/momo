{
  "name": "momo-translator",
  "displayName": "Japanese Text-to-Braille translator for Visual Studio Code",
  "description": "日本語のテキストを点字に翻訳する Visual Studio Code 拡張機能です。WebAssembly による組み込みエンジンを使用しています。",
  "version": "0.8.10",
  "engines": {
    "vscode": "^1.120.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ji6czd/momo.git",
    "directory": "vscode-momo"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "momo-translator.to-kana",
        "title": "Translate to kana"
      },
      {
        "command": "momo-translator.to-braille",
        "title": "Translate to braille"
      },
      {
        "command": "momo-translator.to-segmented",
        "title": "Translate to segmented kana"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~22.19.20",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  }
}
