{
  "name": "momo-translator",
  "displayName": "momo-translator",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "momo-translator.to-kana",
        "title": "Translate to kana"
      },
      {
        "command": "momo-translator.to-braille",
        "title": "Translate to braille"
      },
      {
        "command": "momo-translator.to-segmented",
        "title": "Translate to segmented kana"
      }
    ],
    "configuration": {
      "title": "Momo Translator Configuration",
      "properties": {
        "momoTranslator.serverUrl": {
          "title": "Momo Server URL",
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "momo-server の URL。デフォルトは http://127.0.0.1:8765。`momo-server` コマンドで起動してください。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~22.19.20",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  }
}
